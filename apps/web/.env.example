# Configurar no painel da Vercel (Settings > Environment Variables). Nunca no código.
DATABASE_URL=              # connection string do Neon
SITE_URL=https://SEU-PROJECTO.vercel.app
PAYSUITE_CREATE_URL=       # endereço completo para criar pagamentos (da documentação PaySuite)
PAYSUITE_TOKEN=
PAYSUITE_WEBHOOK_SECRET=
SANDBOX=true
SANDBOX=true
ADMIN_KEY=                 # chave longa e secreta para abrir /admin.html
