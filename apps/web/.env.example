# Configurar no painel da Vercel (Settings > Environment Variables). Nunca no código.
DATABASE_URL=              # connection string do Neon
SITE_URL=https://SEU-PROJECTO.vercel.app
PAYSUITE_CREATE_URL=       # endereço completo para criar pagamentos (da documentação PaySuite)
PAYSUITE_TOKEN=            # só no ambiente do servidor; o painel nunca o lê nem mostra
PAYSUITE_WEBHOOK_SECRET=
SANDBOX=true
CRON_SECRET=               # segredo enviado pela Vercel ao cron diário (/api/admin)

# A chave única do /admin.html já não existe: o painel tem dois administradores
# (tecnoincubadora e kulera) com conta e sessão próprias.
# Criar as contas uma vez, com as senhas fora do repositório:
#   TECNOINCUBADORA_PASSWORD=... KULERA_PASSWORD=... node scripts/seed-admins.mjs
