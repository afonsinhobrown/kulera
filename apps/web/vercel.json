{
  "redirects": [
    {
      "source": "/livro/:id",
      "has": [{ "type": "host", "value": "kulera-omega.vercel.app" }],
      "destination": "https://kulera.tecnoincubadora.org/livro/:id",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/livro/:id", "destination": "/api/livro?id=:id" },
    { "source": "/api/book", "destination": "/api/books?meta=1" }
  ],
  "crons": [{ "path": "/api/admin", "schedule": "0 3 * * *" }]
}
