# Copie para .env (nunca faça commit do .env). Sem valores secretos neste ficheiro.
NODE_ENV=development
PORT=3000

# PaySuite — confirmar valores e caminhos na documentação oficial (https://paysuite.tech/docs)
PAYSUITE_BASE_URL=
PAYSUITE_TOKEN=
PAYSUITE_WEBHOOK_SECRET=
PAYSUITE_CREATE_PATH=/payments
PAYSUITE_GET_PATH=/payments/:id

# Base de dados (a ligar quando o repositório PostgreSQL estiver implementado)
DATABASE_URL=

# Worker de conversão de livros
PANDOC_CMD=pandoc
EPUBCHECK_CMD=epubcheck
DEFAULT_COMMISSION_BPS=2000
